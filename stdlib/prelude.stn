# The core prelude (section 20.1), loaded before every module.
# Functions declared without a body are runtime built-ins (milestone 1, section 22.1).

type Option*[T] = None | Some(value: T)
type Result*[T, E] = Ok(value: T) | Err(error: E)

type ParseError* = InvalidNumber(text: Str) | OutOfRange(text: Str)

# Map and Set (section 3.6): built into the backends as one insertion-ordered hash table
type Map*[K, V]
type Set*[K]

trait Eq*:
    fn eq(a: Self, b: Self) -> Bool
trait Ord*:
    fn cmp(a: Self, b: Self) -> Int
trait Show*:
    fn show(self: Self) -> Str
trait Add*[R]:
    fn add(a: Self, b: R) -> Self
trait Sub*[R]:
    fn sub(a: Self, b: R) -> Self
trait Mul*[R]:
    fn mul(a: Self, b: R) -> Self
trait Div*[R]:
    fn div(a: Self, b: R) -> Self
trait From*[T]:
    fn from(x: T) -> Self
trait Default*:
    fn default() -> Self
trait Copy*:
    fn copy_marker(x: Self) -> Self
trait Hash*:
    fn hash(x: Self) -> Int
# c[k] on a type that is not an Array (sections 3.4 and 4.6): both methods lend out a
# place inside the collection instead of returning a copy
trait Index*[K, V]:
    fn at(c: Self, k: K) -> lend V
trait IndexMut*[K, V]:
    fn at_mut(mut c: Self, k: K) -> lend mut V

# ---- console ----
fn print*(s: Str) ! io
# what `assert_snapshot e` becomes: the text of e, compared by the test runner with its stored copy
fn assert_snapshot_text*(s: Str) ! io
fn read_line*() -> Str? ! io
fn read_all*() -> Str ! io
fn clock_ns*() -> Int ! io
# what the `measure:` line of a bench block becomes: bench_begin, given the limits of its budgets,
# and then `while bench_running():`, the loop that runs the block and reports it
fn bench_begin*(name: Str, label: Str, n: Int, spec: Str, a: Int, b: Int, c: Int, d: Int) ! io
fn bench_running*() -> Bool ! io
# after a bench has run: fails it when its measure block was never reached
fn bench_end*(name: Str) ! io

# ---- arrays ----
fn len*[T](xs: Array[T]) -> Int
fn push*[T](mut xs: Array[T], take x: T)
fn pop*[T](mut xs: Array[T]) -> T?
fn insert*[T](mut xs: Array[T], i: Int, take x: T)
fn remove*[T](mut xs: Array[T], i: Int) -> T
fn clear*[T](mut xs: Array[T])
fn filled*[T](n: Int, x: T) -> Array[T]
fn extend*[T](mut xs: Array[T], ys: Array[T])
fn copy*[T](x: T) -> T
fn unreachable*[T](msg: Str) -> T

# ---- strings ----
fn len*(s: Str) -> Int
# Byte offset into the UTF-8 representation. EOF and invalid offsets yield -1.
fn byte_at_or_end*(s: Str, i: Int) -> Int
fn chars*(s: Str) -> Array[Char]
fn split*(s: Str, sep: Str) -> Array[Str]
fn join*(xs: Array[Str], sep: Str) -> Str
fn trim*(s: Str) -> Str
fn contains*(s: Str, sub: Str) -> Bool
fn starts_with*(s: Str, prefix: Str) -> Bool
fn ends_with*(s: Str, suffix: Str) -> Bool
fn repeat*(s: Str, n: Int) -> Str
# The byte offset of the first place at or after `from` where `sub` stands in `s`; -1 when there
# is none, or when `from` is not an offset into `s`. An empty `sub` stands everywhere.
fn find_or_end*(s: Str, sub: Str, from: Int) -> Int
fn parse_int*(s: Str) -> Int ! ParseError
fn parse_float*(s: Str) -> Float ! ParseError

# ---- maps and sets (section 3.6) ----
fn len*[K, V](m: Map[K, V]) -> Int
fn get*[K: Hash + Eq, V](m: Map[K, V], k: K) -> V?
fn contains*[K: Hash + Eq, V](m: Map[K, V], k: K) -> Bool
fn remove*[K: Hash + Eq, V](mut m: Map[K, V], k: K) -> V?
fn clear*[K, V](mut m: Map[K, V])
fn len*[K](s: Set[K]) -> Int
fn contains*[K: Hash + Eq](s: Set[K], k: K) -> Bool
fn add*[K: Hash + Eq](mut s: Set[K], take k: K)
fn remove*[K: Hash + Eq](mut s: Set[K], k: K) -> Bool
fn clear*[K](mut s: Set[K])

# ---- numbers ----
fn sqrt*(x: Float) -> Float
fn sin*(x: Float) -> Float
fn cos*(x: Float) -> Float
fn tan*(x: Float) -> Float
fn exp*(x: Float) -> Float
fn log*(x: Float) -> Float
fn pow*(x: Float, y: Float) -> Float
fn floor*(x: Float) -> Float
fn ceil*(x: Float) -> Float
fn abs*(x: Float) -> Float
fn abs*(x: Int) -> Int

fn min*[T: Ord](a: T, b: T) -> T:
    if b < a: b else: a

fn max*[T: Ord](a: T, b: T) -> T:
    if b > a: b else: a

# ---- options and results ----
fn or*[T](o: T?, default: T) -> T:
    match o:
        Some(v) -> v
        None -> default

fn is_some*[T](o: T?) -> Bool:
    match o:
        Some(_) -> true
        None -> false

fn is_none*[T](o: T?) -> Bool:
    match o:
        Some(_) -> false
        None -> true

fn unwrap*[T](o: T?) -> T:
    match o:
        Some(v) -> v
        None -> unreachable("unwrap of None")

fn or*[T, E](r: Result[T, E], default: T) -> T:
    match r:
        Ok(v) -> v
        Err(_) -> default

fn is_ok*[T, E](r: Result[T, E]) -> Bool:
    match r:
        Ok(_) -> true
        Err(_) -> false

impl[T: Show] Show for Option[T]:
    fn show(o: Option[T]) -> Str:
        match o:
            Some(v) -> f"Some({v})"
            None -> "None"

impl[T: Show, E: Show] Show for Result[T, E]:
    fn show(r: Result[T, E]) -> Str:
        match r:
            Ok(v) -> f"Ok({v})"
            Err(e) -> f"Err({e})"

impl[T: Show] Show for Array[T]:
    fn show(xs: Array[T]) -> Str:
        var parts: Array[Str] = []
        for x in xs:
            parts.push(f"{x}")
        "[" + join(parts, ", ") + "]"

impl[K: Show, V: Show] Show for Map[K, V]:
    fn show(m: Map[K, V]) -> Str:
        var parts: Array[Str] = []
        for (k, v) in m:
            parts.push(f"{k}: {v}")
        "{" + join(parts, ", ") + "}"

# an empty Set is shown as it is written, since {} is also an empty Map
impl[K: Show] Show for Set[K]:
    fn show(s: Set[K]) -> Str:
        if len(s) == 0:
            "Set()"
        else:
            var parts: Array[Str] = []
            for k in s:
                parts.push(f"{k}")
            "{" + join(parts, ", ") + "}"

impl Show for ParseError:
    fn show(e: ParseError) -> Str:
        match e:
            InvalidNumber(t) -> f"invalid number '{t}'"
            OutOfRange(t) -> f"number out of range '{t}'"

# ---- algorithms over arrays ----
fn contains*[T: Eq](xs: Array[T], x: T) -> Bool:
    for y in xs:
        if y == x:
            return true
    false

fn reverse*[T](mut xs: Array[T]):
    var i = 0
    var j = len(xs) - 1
    while i < j:
        let t = xs[i]
        xs[i] = xs[j]
        xs[j] = t
        i += 1
        j -= 1

# two elements of one array change places: the part of the array that two mut arguments cannot both be
fn swap*[T](mut xs: Array[T], i: Int, j: Int):
    let t = xs[i]
    xs[i] = xs[j]
    xs[j] = t

fn sort*[T: Ord](mut xs: Array[T]):
    # insertion sort for short arrays, merge sort otherwise; stable
    let n = len(xs)
    if n < 2:
        return
    if n <= 16:
        var i = 1
        while i < n:
            let x = xs[i]
            var j = i
            while j > 0 and xs[j - 1] > x:
                xs[j] = xs[j - 1]
                j -= 1
            xs[j] = x
            i += 1
        return
    let mid = n / 2
    var left = xs[0..mid]
    var right = xs[mid..n]
    sort(mut left)
    sort(mut right)
    var i = 0
    var j = 0
    var k = 0
    while i < len(left) and j < len(right):
        if right[j] < left[i]:
            xs[k] = right[j]
            j += 1
        else:
            xs[k] = left[i]
            i += 1
        k += 1
    while i < len(left):
        xs[k] = left[i]
        i += 1
        k += 1
    while j < len(right):
        xs[k] = right[j]
        j += 1
        k += 1

# ---- strings, written in Starnite ----
# Searching instead of slicing: a parser that asks where the next separator is, and takes the piece
# before it, never copies what it has not reached. The pieces are slices, which are views of `s`
# while they are only read.

# the byte offset of the first `sub` in `s`
fn find*(s: Str, sub: Str) -> Int?:
    find_from(s, sub, 0)

# the byte offset of the first `sub` in `s` at or after the offset `from`
fn find_from*(s: Str, sub: Str, from: Int) -> Int?:
    let at = find_or_end(s, sub, from)
    if at < 0:
        None
    else:
        Some(at)

# what stands before the first `sep` in `s`, and what stands after it
fn split_once*(s: Str, sep: Str) -> (Str, Str)?:
    let at = find_or_end(s, sep, 0)
    if at < 0:
        None
    else:
        Some((s[0..at], s[at + len(sep)..len(s)]))

# The lines of `s`. A line ends at a newline, which is not part of it, nor is a carriage return
# just before it; text after the last newline is a line too, unless it is empty.
fn lines*(s: Str) -> Array[Str]:
    var out: Array[Str] = []
    var start = 0
    while start < len(s):
        var stop = find_or_end(s, "\n", start)
        let ended = stop >= 0
        if not ended:
            stop = len(s)
        # a carriage return is dropped only where a newline follows it
        if ended and stop > start and byte_at_or_end(s, stop - 1) == 13:
            out.push(s[start..stop - 1])
        else:
            out.push(s[start..stop])
        if ended:
            start = stop + 1
        else:
            start = stop
    out

# the pieces between runs of white space: a space, a tab, a newline or a carriage return
fn words*(s: Str) -> Array[Str]:
    var out: Array[Str] = []
    let n = len(s)
    var i = 0
    while i < n:
        var c = byte_at_or_end(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13:
            i += 1
        else:
            var j = i + 1
            c = byte_at_or_end(s, j)
            while j < n and not (c == 32 or c == 9 or c == 10 or c == 13):
                j += 1
                c = byte_at_or_end(s, j)
            out.push(s[i..j])
            i = j
    out
