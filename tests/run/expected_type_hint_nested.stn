# Nested calls that all fall back are checked in bounded time. In each call here, the expected type
# the call gets for its result does not match what its arguments say (the variable `xs` is an
# Array[Int], where the expected type asks for an Array[Int?]), so a check that bound the
# parameters to it would fail at `xs` after checking the nested call, and be repeated without it:
# the work would double at every level. The expected type is an expectation first, and parameters
# are bound to it only if that does not check, or the result does not fit. Chains of forty calls
# are checked beside calls that need the expected type for their literals, in the same call and
# in the same function, and beside a bound that only the bound version satisfies.
trait Tag:
    fn tag(x: Self) -> Str

impl Tag for Option[Int]:
    fn tag(x: Option[Int]) -> Str:
        "opt"

fn keep_tag[T: Tag](x: T) -> T:
    x

fn choose_nested[T](inner: Int?, xs: Array[T], fallback: T) -> T:
    fallback

fn contextual[T](inner: F32?, value: T) -> T:
    value

fn pick[T](a: T, b: T) -> T:
    a

fn pair(a: Int?, b: F32?) -> (Int?, F32?):
    (a, b)

fn two(a: Int?, b: Int?) -> (Int?, Int?):
    (a, b)

