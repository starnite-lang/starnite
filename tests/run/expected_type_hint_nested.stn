# Nested calls are checked in bounded time. In each chain here the expected type asks for an
# Array[Int?] where the variable `xs` is an Array[Int], so a check with the parameters bound to the
# expected type fails at `xs` and the call is checked on its own; each retry would check the nested
# call again, and the work would double at every level. It does not, in three ways. A nested call
# that is the first argument, which the expected type cannot change (`choose_nested`), is checked
# once and kept by both tries. A call that already failed with the expected type is not tried with
# it again, which is what bounds `late`, where a literal or a variable comes before the nested
# call, and `dep`, where the nested call is the argument the expected type changes. What it
# remembers is the state the failure depended on: the variables the check looked at, and their
# types. It is not used when a retry has changed the type of one of them, wherever the check found
# it: in an argument, or in a call or a constructor inside one. (A default is written where the
# parameter is declared and does not see the variables of the call, so it cannot be one of them.)
# And a budget of retries stands behind both.
#
# `need_tag` is the other way round: the bound holds only for the type the expected type gives, so
# the first try is the one that works. Chains of forty calls are checked beside calls that need the
# expected type for their literals, in the same call and in the same function, and beside a bound
# that only the bound version satisfies.
trait Tag:
    fn tag(x: Self) -> Str

impl Tag for Option[Int]:
    fn tag(x: Option[Int]) -> Str:
        "opt"

fn keep_tag[T: Tag](x: T) -> T:
    x

fn need_tag[T: Tag](inner: Int?, x: T) -> T:
    x

fn choose_nested[T](inner: Int?, xs: Array[T], fallback: T) -> T:
    fallback

fn late[T](x: T, inner: Int?, xs: Array[T]) -> T:
    x

fn dep[T](x: T, xs: Array[T]) -> T:
    x

fn inner_pair[A, B](xs: Array[A], b: B) -> (Array[A], B):
    (xs, b)

fn outer_seed[T](seed: T, xs: Array[T], p: (Array[Int], F32?)) -> T:
    seed

fn contextual[T](inner: F32?, value: T) -> T:
    value

fn pick[T](a: T, b: T) -> T:
    a

fn pair(a: Int?, b: F32?) -> (Int?, F32?):
    (a, b)

fn two(a: Int?, b: Int?) -> (Int?, Int?):
    (a, b)

