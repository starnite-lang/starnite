# Nested calls are checked in bounded time. In the chains of `choose_nested`, the expected type
# asks for an Array[Int?] where the variable `xs` is an Array[Int], so a check with the
# parameters bound to it fails at `xs` and the call is checked on its own. The nested call is
# the first argument, which the expected type cannot change, so it is checked once and kept by
# both tries, and the work does not double at every level. So it is in `late`, where only a
# literal comes before it. `need_tag` is the other way round: the bound holds only for the type
# the expected type gives, so the first try is the one that works, and no level is checked
# twice. Chains of forty calls are checked beside calls that need the expected type for their
# literals, in the same call and in the same function, and beside a bound that only the bound
# version satisfies.
trait Tag:
    fn tag(x: Self) -> Str

impl Tag for Option[Int]:
    fn tag(x: Option[Int]) -> Str:
        "opt"

fn keep_tag[T: Tag](x: T) -> T:
    x

fn need_tag[T: Tag](inner: Int?, x: T) -> T:
    x

fn choose_nested[T](inner: Int?, xs: Array[T], fallback: T) -> T:
    fallback

fn late[T](x: T, inner: Int?, xs: Array[T]) -> T:
    x

fn contextual[T](inner: F32?, value: T) -> T:
    value

fn pick[T](a: T, b: T) -> T:
    a

fn pair(a: Int?, b: F32?) -> (Int?, F32?):
    (a, b)

fn two(a: Int?, b: Int?) -> (Int?, Int?):
    (a, b)

