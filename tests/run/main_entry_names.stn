# main calls a function that loops through a hot entry (section 11). The entry's name cannot be one
# of the program's own: a function named work_entry stands beside work. A main that loops and calls
# itself calls itself directly (here it reads no line, so it runs once, but it must compile).
fn work() -> Int:
    var t = 0
    for i in 0..10:
        t += i
    t

fn work_entry() -> Str:
    "the program's own work_entry"

fn main():
    print(f"{work()} {work_entry()}")
    var n = 0
    for i in 0..3:
        n += i
    match read_line():
        Some(_) -> main()
        None -> print(f"done {n}")
