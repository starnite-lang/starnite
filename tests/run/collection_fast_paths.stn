fn borrow_string(a: Array[Str]) -> Str:
    let x = a[0]
    x

fn main():
    var a = [repeat("string", 2), "é"]
    let original = a
    let popped = unwrap(a.pop())
    clear(mut a)
    a.push("new")
    print(f"{original} {popped} {a} {borrow_string(original)}")
    let words = ["ab\0c", "é漢é"]
    print(f"{contains(words[0], "\0c")} {split(words[1], "é")} {join(["alpha", words[1]], "|")}")
    var values = [9223372036854775807, -7, -42, 0, 3, -7]
    for i in 0..40:
        values.push(i - 20)
    let snapshot = values
    sort(mut values)
    reverse(mut values)
    print(f"{values[0]} {values[45]} {snapshot[1]} {contains(values, -42)}")
    print(f"{parse_int("-9223372036854775808")} {parse_int("+9223372036854775807")}")
    print(f"{try parse_int("999999999999999999999x")} {try parse_int("999999999999999999999")}")
    print(f"{parse_float("-0.0")} {parse_float(".125")} {parse_float("1e5")} {parse_float("2.2250738585072014e-308")}")
    # eight digits per step: one block, two blocks and a tail, and a non-digit inside a block
    print(f"{parse_int("98765432")} {parse_int("-123456789012345678")} {parse_int("+12345678")}")
    print(f"{try parse_int("1234567x")} {try parse_int("12345678:")} {try parse_int("/2345678")}")
    # the short float parse: digits on both sides of the point, none on one side, two points
    print(f"{parse_float("123.125")} {parse_float("-7.")} {parse_float("+42")} {try parse_float("1.2.3")} {try parse_float("-")}")
    # chars: a run of sixteen ASCII bytes, a run cut short by a longer character, and a tail
    let wide = chars("0123456789abcdefXYZé0123456789abcde漢0123456789abcdef!")
    print(f"{len(wide)} {wide[15]} {wide[19]} {wide[35]} {wide[36]} {wide[52]}")
    # a sort large enough for wide digits, with negative keys and a constant low byte
    var big: Array[Int] = []
    var x = 12345
    for i in 0..20000:
        x = (x * 1103515245 + 12345) % 2147483648
        big.push((x - 1073741824) * 256)
    sort(mut big)
    var ordered = true
    for i in 1..20000:
        if big[i - 1] > big[i]:
            ordered = false
    print(f"{ordered} {big[0]} {big[10000]} {big[19999]}")
    # a counted loop of single pushes reserves once: a fresh array, one that already holds
    # elements, and one that shares its buffer with a snapshot
    var pairs: Array[(Int, Int)] = []
    for i in 0..3000:
        pairs.push((i, 3 * i))
    let before = pairs
    for i in 0..2000:
        pairs.push((0 - i, i))
    print(f"{len(pairs)} {len(before)} {pairs[2999].1} {pairs[4999].0} {before[2999].0}")
    # a stride index that wraps: stores through it, then reads through it
    var ring = filled(1000, 0)
    for i in 0..5000:
        ring[(i * 7) % 1000] = i
    var seen = 0
    for i in 0..5000:
        seen += ring[(i * 993) % 1000]
    print(f"{ring[0]} {ring[7]} {ring[999]} {seen}")
    # sum += e stores the checked add in place: the same value, and the same trap
    var total = 9223372036854775800
    let parts = [(1, 2), (3, 1)]
    for pair in parts:
        let (p, q) = pair
        total += p + q
    print(f"{total}")
    total += parts[0].1 + 0
