fn find_first(xs: Array[Int], target: Int) -> Int?:
    var i = 0
    for x in xs:
        if x == target:
            return Some(i)
        i += 1
    None

fn main():
    var out: Array[Int] = []
    for i in 0..20:
        if i % 2 == 0:
            continue
        if i > 11:
            break
        out.push(i)
    print(f"{out}")
    var n = 27
    var steps = 0
    while n != 1:
        n = if n % 2 == 0: n / 2 else: 3 * n + 1
        steps += 1
    print(f"collatz {steps}")
    print(f"{find_first([4, 5, 6], 6)} {find_first([4], 9)}")
    let grade = 85
    let letter = if grade >= 90: "A" else: if grade >= 80: "B" else: "C"
    print(letter)
    var found = false
    for a in 1..20:
        for b in a..20:
            if a * a + b * b == 13 * 13 and not found:
                print(f"{a} {b}")
                found = true
    check found
