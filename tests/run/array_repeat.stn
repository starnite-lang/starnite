# [x; n] is n copies of x in one allocation, the same as filled(n, x) (section 4.2). The count is
# evaluated first, then the element, once. The result is an ordinary array.
type Point = struct(x: Int, y: Int)

fn count() -> Int:
    print("count")
    3

fn element() -> Str:
    print("element")
    "ab"

fn main():
    var grid = [0; 5]
    grid[2] = 7
    grid.push(9)
    print(f"{grid} {len(grid)}")
    let flags = [false; 2]
    let words = [element(); count()]
    print(f"{flags} {words}")
    let rows = [[1, 2]; 2]
    var copy = rows
    copy[0].push(3)
    print(f"{rows} {copy}")
    let points = [Point(1, 2); 2]
    let empty: Array[Int] = [0; 0]
    let floats = [1.5; 2]
    print(f"{points[1].y} {len(empty)} {floats} {[1 + 1; 1 + 2]}")
    let n = 0 - 1
    let bad = [0; n]
    print(f"{len(bad)}")
