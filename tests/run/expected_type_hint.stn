# The expected type is a hint for a generic result: it lets a literal argument take its type from
# the context. A receiver is typed before the hint is used, so when it decides the result and the
# value is then boxed or wrapped, the hint is not taken; a receiver that leaves the result open,
# such as an empty literal, does not decide it.
fn pick[T](a: T, b: T) -> T:
    a

fn choose[T](xs: Array[T], fallback: T) -> T:
    fallback

fn main() ! io:
    let a: any Show = (Some(5)).or(4)
    let b: Int? = (Some(5)).or(4)
    let c: any Show = pick(7, 8)
    let d: Int? = pick(9, 10)
    let e: Array[any Show] = [pick("x", "y"), (Some(2)).or(3)]
    print(f"{a} {b} {c} {d} {e}")
    # a literal inside an argument that is already wrapped takes its type from the context
    let f: F32? = pick(Some(1.0), None)
    let g: Float? = pick(Some(2.5), None)
    print(f"{f} {g}")
    # the same through a method call whose receiver is an empty literal
    let xs = []
    let h: F32? = xs.choose(Some(1.0))
    let ys = [3, 4]
    let i: any Show = ys.choose(5)
    print(f"{h} {i}")
