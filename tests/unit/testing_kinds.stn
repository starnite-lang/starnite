# Property, snapshot and doc tests (section 20.2), all passing: the inputs of a property test are
# generated from their types, assert_snapshot compares with tests/unit/snapshots/testing_kinds/,
# and the >>> examples in the doc comments are run.
type Shape = Dot | Circle(r: Int) | Rect(w: Int, h: Int)
type Tree = Leaf | Node(left: Tree, value: Int, right: Tree)
type Pair = struct(a: Int, b: Str)

## The larger of two numbers.
##
##     >>> larger(2, 3)
##     3
##     >>> larger(-1, -5)
##     -1
fn larger(a: Int, b: Int) -> Int:
    if a > b:
        a
    else:
        b

## The words of a text, and how many there are.
##     >>> words("a b  c")
##     [a, b, c]
fn size(t: Tree) -> Int:
    match t:
        Leaf -> 0
        Node(l, _, r) -> size(l) + 1 + size(r)

fn area(s: Shape) -> Int:
    match s:
        Dot -> 0
        Circle(r) -> 3 * r * r
        Rect(w, h) -> w * h

test "sorting keeps the length" for xs: Array[Int]:
    var ys = xs
    sort(mut ys)
    assert len(ys) == len(xs)

test "larger is one of the two" for a: Int, b: Int:
    let m = larger(a, b)
    assert m == a or m == b
    assert m >= a and m >= b

test "an index within the array" for xs: Array[Int], i: Int where 0 <= i and i < len(xs):
    assert xs[i] == xs[i]

test "trees and pairs and maps" for t: Tree, p: Pair, m: Map[Str, Int], s: Set[Char], o: Int?, f: Float:
    assert size(t) >= 0
    assert len(p.b) >= 0
    assert len(m) >= 0 and len(s) >= 0

# a type that holds itself through an array
type Rose = Tip | Branch(children: Array[Rose])

fn tips(r: Rose) -> Int:
    match r:
        Tip -> 1
        Branch(cs) ->
            var n = 0
            for c in cs:
                n = n + tips(c)
            n

test "a tree of arrays of trees" for r: Rose:
    assert tips(r) >= 0

# the variant that ends is not the first, and has as many fields as the one that goes on
type Chain = Link(next: Chain) | End(value: Int)

fn links(c: Chain) -> Int:
    match c:
        Link(next) -> 1 + links(next)
        End(_) -> 0

test "a chain ends" for c: Chain:
    assert links(c) >= 0

# every step down is another type: Nest[Int], Nest[Array[Int]], and so on
type Nest[T] = Stop | Down(next: Nest[Array[T]])

fn steps[T](n: Nest[T]) -> Int:
    match n:
        Stop -> 0
        Down(next) -> 1 + steps(next)

test "a type whose arguments grow" for n: Nest[Int]:
    assert steps(n) >= 0

# two types that hold each other: the first ends with Last, which the generator has to find
type First = More(next: Second) | Last(value: Int)
type Second = Back(next: First)

fn depth(f: First) -> Int:
    match f:
        More(Back(next)) -> 1 + depth(next)
        Last(_) -> 0

test "types that hold each other" for f: First:
    assert depth(f) >= 0

test "a snapshot":
    assert_snapshot [(area(Rect(2, 3)), "rect"), (area(Circle(1)), "circle")]
    assert_snapshot larger(4, 9)
