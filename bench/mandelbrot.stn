# Mandelbrot: count the points of a 2000 x 2000 grid that stay bounded
fn main():
    let size = 2000
    var inside = 0
    for y in 0..size:
        let ci = 2.0 * Float(y) / Float(size) - 1.0
        for x in 0..size:
            let cr = 2.0 * Float(x) / Float(size) - 1.5
            var zr = 0.0
            var zi = 0.0
            var i = 0
            var escaped = false
            while i < 50 and not escaped:
                let tr = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = tr
                if zr * zr + zi * zi > 4.0:
                    escaped = true
                i += 1
            if not escaped:
                inside += 1
    print(f"{inside}")
