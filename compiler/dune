(executable
 (name main)
 (public_name starnite)
 (libraries unix threads.posix)
 (flags (:standard -w +a-4-9-26-27-32..42-44-45-69-70 -warn-error -a)))

(rule
 (targets runtime_src.ml)
 (deps ../runtime/stn_runtime.h ../runtime/stn_runtime.c ../stdlib/prelude.stn)
 (action
  (with-stdout-to %{targets}
   (progn
    (echo "(* Generated from runtime/ and stdlib/prelude.stn; do not edit. *)\n")
    (echo "let header = {stnrt|")
    (cat ../runtime/stn_runtime.h)
    (echo "|stnrt}\n")
    (echo "let source = {stnrt|")
    (cat ../runtime/stn_runtime.c)
    (echo "|stnrt}\n")
    (echo "let prelude = {stnrt|")
    (cat ../stdlib/prelude.stn)
    (echo "|stnrt}\n")))))
